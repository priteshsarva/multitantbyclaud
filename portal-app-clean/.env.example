# Copy to .env and set your server URL
VITE_API_URL=http://localhost:3002

# Where a hosted storefront is reachable, {slug} is replaced with the site's slug.
# Local dev (no wildcard DNS): the storefront app resolves the tenant from ?store=.
# Production once wildcard DNS is set up: https://{slug}.yourplatform.com
VITE_STORE_BASE_URL=http://localhost:5175/?store={slug}
